{
  "name": "@modulaga/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "node scripts/generate.mjs && tsc -p tsconfig.json"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/*": "./src/schemas/*"
  },
  "devDependencies": {
    "@types/node": "24.10.9",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  }
}