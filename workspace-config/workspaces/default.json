{
  "schemaVersion": 1,
  "workspace": {
    "id": "default",
    "name": "Default workspace"
  },
  "welcomePage": {
    "enabled": true,
    "title": "Welcome to Modulaga",
    "description": "Your workspace, apps, and dashboards in one place.",
    "showDashboard": true
  },
  "installations": [
    {
      "id": "orders-installation",
      "appId": "orders",
      "releaseId": "orders@1.2.0",
      "basePath": "/orders",
      "settings": {
        "schemaId": "orders-install-settings",
        "value": {}
      }
    },
    {
      "id": "content-types-installation",
      "appId": "content-types",
      "releaseId": "content-types@static",
      "basePath": "/content-types",
      "settings": {
        "schemaId": "content-types-install-settings",
        "value": {}
      }
    },
    {
      "id": "application-generator-installation",
      "appId": "application-generator",
      "releaseId": "application-generator@static",
      "basePath": "/applications",
      "settings": {
        "schemaId": "application-generator-install-settings",
        "value": {}
      }
    },
    {
      "id": "admin-panel-installation",
      "appId": "admin-panel",
      "releaseId": "admin-panel@static",
      "basePath": "/settings",
      "settings": {
        "schemaId": "admin-panel-install-settings",
        "value": {}
      }
    }
  ],
  "routes": [
    {
      "id": "orders-overview",
      "installationId": "orders-installation",
      "path": "/orders/overview"
    },
    {
      "id": "orders-analytics",
      "installationId": "orders-installation",
      "path": "/orders/analytics"
    },
    {
      "id": "content-types-overview",
      "installationId": "content-types-installation",
      "path": "/content-types"
    },
    {
      "id": "application-generator-home",
      "installationId": "application-generator-installation",
      "path": "/applications/generator"
    },
    {
      "id": "application-generator-templates",
      "installationId": "application-generator-installation",
      "path": "/applications/generator/templates"
    },
    {
      "id": "application-generator-template-create",
      "installationId": "application-generator-installation",
      "path": "/applications/generator/templates/create"
    },
    {
      "id": "application-generator-template-edit",
      "installationId": "application-generator-installation",
      "path": "/applications/generator/templates/edit"
    },
    {
      "id": "workspace-settings",
      "installationId": "admin-panel-installation",
      "path": "/workspace-settings"
    }
  ],
  "menus": [
    {
      "id": "primary",
      "name": "Primary navigation",
      "entries": [
        {
          "id": "operations",
          "type": "section",
          "label": "Operations",
          "icon": "briefcase",
          "visible": true,
          "children": [
            {
              "id": "orders-link",
              "type": "route",
              "label": "Orders",
              "routeId": "orders-overview",
              "icon": "cart",
              "visible": true
            },
            {
              "id": "analytics-link",
              "type": "route",
              "label": "Analytics",
              "routeId": "orders-analytics",
              "icon": "chart",
              "visible": true
            }
          ]
        },
        {
          "id": "settings",
          "type": "section",
          "label": "Settings",
          "visible": true,
          "children": [
            {
              "id": "help-link",
              "type": "external",
              "label": "Help center",
              "href": "https://example.com/help",
              "icon": "grid",
              "visible": true
            },
            {
              "id": "content-types-link",
              "type": "route",
              "label": "Content types",
              "routeId": "content-types-overview",
              "icon": "box",
              "visible": true
            },
            {
              "id": "application-generator-link",
              "type": "route",
              "label": "Application generator",
              "routeId": "application-generator-home",
              "icon": "box",
              "visible": true
            }
          ]
        }
      ]
    }
  ],
  "menuPlacements": [
    {
      "menuId": "primary",
      "region": "left",
      "renderer": "tree",
      "breakpoint": "desktop"
    }
  ],
  "shell": {
    "sidebar": {
      "width": 264,
      "mode": "collapsible",
      "defaultCollapsed": false,
      "adminMenuSettingsPath": "/workspace-settings"
    },
    "breadcrumbs": {
      "enabled": true,
      "maxDepth": 5,
      "separator": "/"
    }
  },
  "dashboards": [
    {
      "id": "workspace-overview",
      "title": "Workspace overview",
      "routeId": "orders-overview",
      "columns": 3,
      "widgets": [
        {
          "id": "active-users-panel",
          "installationId": "orders-installation",
          "componentId": "stat-card",
          "settings": {
            "schemaId": "modulaga-stat-card",
            "value": {
              "label": "Active users",
              "value": "2,847"
            }
          }
        },
        {
          "id": "workspace-count-panel",
          "installationId": "orders-installation",
          "componentId": "stat-card",
          "settings": {
            "schemaId": "modulaga-stat-card",
            "value": {
              "label": "Workspaces",
              "value": "12"
            }
          }
        },
        {
          "id": "remote-count-panel",
          "installationId": "orders-installation",
          "componentId": "stat-card",
          "settings": {
            "schemaId": "modulaga-stat-card",
            "value": {
              "label": "Microfrontends",
              "value": "8"
            }
          }
        }
      ]
    }
  ],
  "layout": {
    "template": "single-column",
    "regions": [
      {
        "id": "main",
        "order": 0,
        "instances": []
      }
    ]
  },
  "theme": {
    "id": "modulaga-default",
    "version": "1.0.0"
  },
  "services": []
}
